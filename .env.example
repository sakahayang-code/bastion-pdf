# BastionPDF Production Environment Variables
PORT=3000
NODE_ENV=production
DATABASE_URL=file:/app/data/replica.db
STORAGE_DIR=/app/data/storage
RETENTION_HOURS=2

# Security & Secrets
SESSION_SECRET=change-me-to-a-secure-random-64-char-string
CORS_ORIGIN=https://bastionpdf.com

# Stripe Live Keys (Pro / Enterprise Tiers)
STRIPE_SECRET_KEY=sk_live_replace_with_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# Optional External S3 / MinIO Storage (Defaults to local zero-trace filesystem)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
